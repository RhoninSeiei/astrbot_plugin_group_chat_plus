+    @staticmethod
+    def _publish_request_handoff(event, req, part, memories) -> bool:
+        """Expose structured results only to this exact opted-in request.
+
+        The consumer owns clearing the request-local extras. Ordinary requests
+        retain their original TextPart and do not copy or publish any memories.
+        """
+        try:
+            if req is None or event.get_extra('_gcp_lm_handoff_requested', None) is not req:
+                return False
+            if not getattr(part, '_no_save', False):
+                return False
+            event.set_extra('_gcp_lm_handoff', {
+                'version': 1,
+                'request': req,
+                'part': part,
+                'memories': copy.deepcopy(memories),
+                'formatter': format_memories_for_injection,
+            })
+            return True
+        except Exception:
+            # Optional compatibility must not change successful native recall.
+            return False
