+def _phrase_alias(raw, known, *, particle='', infer_particle=False, other_owner=False):
+    """Read a whole alias token. Quoted spelling always wins over particles."""
+    raw = raw.strip()
+    for left, right in [('“', '”'), ('「', '」'), ('"', '"'), ("'", "'")]:
+        if raw.startswith(left):
+            end = raw.find(right, len(left))
+            if end < 0 or raw[end + 1:].strip() not in ('', particle):
+                return ''
+            return alias_value(raw[:end + 1])
+    if raw in _REFERENTIAL_ALIAS or _UNQUOTED_CLAUSE.search(raw) or (other_owner and _OTHER_OWNER.match(raw)):
+        return ''
+    full = alias_value(raw)
+    if not particle or not raw.endswith(particle):
+        return full
+    short = alias_value(raw[:-len(particle)].rstrip())
+    if not short:
+        return full
+    full_known, short_known = full.casefold() in known, short.casefold() in known
+    if raw.endswith(particle * 2) and not full_known and not short_known:
+        return ''
+    if full_known and short_known:
+        return ''  # Both are genuine names: a quote is needed to disambiguate.
+    if full_known:
+        return full
+    if not full:
+        return '' if raw.casefold() in known else short
+    if short_known or infer_particle:
+        return short
+    # A first-ever withdrawal ending in 了 can equally name the literal suffix.
+    return ''
+
+
+def _self_actions(text, known):
+    """Return validated first-person actions; no partial compound execution."""
+    text = unicodedata.normalize('NFKC', text).strip().rstrip('。!').strip()
+    replace = _REPLACE_SELF.fullmatch(text)
+    if replace:
+        if replace[1].lstrip().startswith('们'):
+            return []
+        new = _phrase_alias(replace[1], known, particle='吧', infer_particle=True)
+        old = _phrase_alias(replace[2], known, particle='了', other_owner=True)
+        if not new or not old or new.casefold() == old.casefold():
+            return []
+        return [(new, 'self_confirmed'), (old, 'self_denied')]
+    dont_call = _DONT_CALL_SELF.fullmatch(text)
+    if dont_call:
+        alias = _phrase_alias(dont_call[1], known)
+        return [(alias, 'self_denied')] if alias else []
+    match = _SELF.fullmatch(text)
+    if not match:
+        return []
+    if match[1].endswith('我') and match[2].lstrip().startswith('们'):
+        return []
+    negative = match[1] in {'别叫我', '我的花名不是', '不要叫我', '别再叫我', '请停止叫我', '我现在不叫'}
+    declaration = match[1] in {'我的花名是', '我的昵称是'}
+    particle = '了' if negative else ('' if declaration else '吧')
+    alias = _phrase_alias(match[2], known, particle=particle, infer_particle=not negative)
+    return [(alias, 'self_denied' if negative else 'self_confirmed')] if alias else []
+
