+"""Frozen semantic gaps plus conservative natural-name grammar boundaries."""
+import sqlite3
+import unittest
+from contextlib import closing
+import test_identity_service as base
+
+FROZEN_GAPS=[
+('NL103','以后叫我星河。',[],['星河'],[]),
+('NL104','今后就叫我星河吧。',[],['星河'],[]),
+('NL105','在这个群里称呼我星河。',[],['星河'],[]),
+('NL106','你可以叫我星河。',[],['星河'],[]),
+('NL107','麻烦叫我星河。',[],['星河'],[]),
+('NL108','请叫我星河吧。',[],['星河'],[]),
+('NL109','不要叫我星河了。',['请叫我“星河”'],[],['星河']),
+('NL110','别再叫我星河了。',['请叫我“星河”'],[],['星河']),
+('NL111','以后别用星河称呼我。',['请叫我“星河”'],[],['星河']),
+('NL112','请停止叫我星河。',['请叫我“星河”'],[],['星河']),
+('NL113','我现在不叫星河了。',['请叫我“星河”'],[],['星河']),
+('NL114','改叫我云帆，不再叫星河。',['请叫我“星河”'],['云帆'],['星河']),
+]
+
+class NaturalGrammarTests(unittest.IsolatedAsyncioTestCase):
+    asyncSetUp=base.IdentityTests.asyncSetUp
+    asyncTearDown=base.IdentityTests.asyncTearDown
+    async def send(self,text,**kwargs):
+        return await self.service.observe_event(base.Event(text,**kwargs))
+    async def snapshot(self):
+        return await self.service.get_identity_context(base.Event('现在应该怎么称呼我？'))
+    def claims(self):
+        with closing(sqlite3.connect(self.service.path)) as con:
+            return con.execute('SELECT count(*) FROM claims').fetchone()[0]
+    async def test_frozen_twelve_semantic_gaps(self):
+        for case_id,text,setup,expected_aliases,expected_denied in FROZEN_GAPS:
+            with self.subTest(case_id=case_id):
+                service=base.IdentityService(self.temp/('controlled-'+case_id),self.config)
+                await service.start()
+                try:
+                    for previous in setup: await service.observe_event(base.Event(previous))
+                    await service.observe_event(base.Event(text))
+                    result=await service.get_identity_context(base.Event('现在应该怎么称呼我？'))
+                    owner=result['subjects'][0]
+                    self.assertEqual(owner['confirmed_aliases'],expected_aliases)
+                    self.assertEqual(owner['denied_aliases'],expected_denied)
+                finally: await service.close()
+    async def test_quoted_real_name_ending_ba_is_not_trimmed(self):
+        await self.send('以后叫我“拾光吧”吧。')
+        self.assertEqual((await self.snapshot())['subjects'][0]['confirmed_aliases'],['拾光吧'])
+    async def test_known_unquoted_real_name_ending_ba_is_preserved(self):
+        await self.send('请叫我“拾光吧”')
+        await self.send('以后叫我拾光吧。')
+        self.assertEqual((await self.snapshot())['subjects'][0]['confirmed_aliases'],['拾光吧'])
+    async def test_confirmation_never_strips_name_ending_le(self):
+        await self.send('以后叫我小知了。')
+        self.assertEqual((await self.snapshot())['subjects'][0]['confirmed_aliases'],['小知了'])
+    async def test_known_real_name_ending_le_is_withdrawn_whole(self):
+        await self.send('请叫我“小知了”')
+        await self.send('不要叫我小知了。')
+        owner=(await self.snapshot())['subjects'][0]
+        self.assertEqual(owner['confirmed_aliases'],[])
+        self.assertEqual(owner['denied_aliases'],['小知了'])
+    async def test_quoted_name_ending_le_plus_sentence_particle(self):
+        await self.send('请叫我“小知了”')
+        await self.send('不要叫我“小知了”了。')
+        self.assertEqual((await self.snapshot())['subjects'][0]['denied_aliases'],['小知了'])
+    async def test_two_known_particle_interpretations_require_explicit_quote(self):
+        await self.send('请叫我“星河”')
+        await self.send('请叫我“星河吧”')
+        before=self.claims()
+        await self.send('以后叫我星河吧。')
+        self.assertEqual(self.claims(),before)
+        self.assertEqual(set((await self.snapshot())['subjects'][0]['confirmed_aliases']),{'星河','星河吧'})
+    async def test_unknown_denial_particle_is_not_guessed(self):
+        await self.send('不要叫我小知了。')
+        self.assertEqual((await self.snapshot())['subjects'][0]['denied_aliases'],[])
+    async def test_invalid_replacement_new_name_never_revokes_old(self):
+        await self.send('请叫我“星河”')
+        await self.send('改叫我“管理员”，不再叫星河。')
+        owner=(await self.snapshot())['subjects'][0]
+        self.assertEqual(owner['confirmed_aliases'],['星河'])
+        self.assertEqual(owner['denied_aliases'],[])
+    async def test_same_normalized_replacement_is_rejected_atomically(self):
+        await self.send('请叫我“Alice”')
+        before=self.claims()
+        await self.send('改叫我ALICE，不再叫Alice。')
+        self.assertEqual(self.claims(),before)
+        self.assertEqual((await self.snapshot())['subjects'][0]['confirmed_aliases'],['Alice'])
+    async def test_late_replacement_does_not_apply_only_one_side(self):
+        await self.send('请叫我“星河”')
+        old=base.Event('改叫我云帆，不再叫星河。');self.service.prepare_event(old)
+        await self.send('请叫我“星河”')
+        await self.service.observe_event(old)
+        owner=(await self.snapshot())['subjects'][0]
+        self.assertEqual(owner['confirmed_aliases'],['星河'])
+        self.assertEqual(owner['denied_aliases'],[])
+    async def test_replacement_rolls_back_both_actions_on_storage_failure(self):
+        await self.send('请叫我“星河”')
+        with closing(sqlite3.connect(self.service.path)) as con:
