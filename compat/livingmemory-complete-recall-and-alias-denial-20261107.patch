diff --git a/tests/test_memory_formatter_integrity.py b/tests/test_memory_formatter_integrity.py
new file mode 100644
index 0000000..95b2131
--- /dev/null
+++ b/tests/test_memory_formatter_integrity.py
@@ -0,0 +1,87 @@
+"""A budget may defer a whole memory, never amputate a retained fact."""
+import copy
+from functools import partial
+
+import pytest
+
+from astrbot_plugin_livingmemory.core.utils.formatting import (
+    _get_default_injection_footer,
+    _get_default_injection_header,
+    format_memories_for_injection,
+)
+
+
+@pytest.mark.parametrize('metadata', [{}, {'key_facts': []}, {'key_facts': ['independent fact']}])
+def test_long_content_tail_survives_without_requiring_key_facts(metadata):
+    content = 'BEGIN_FACT\n' + '长摘要背景。' * 190 + '\nFINAL_FACT_879'
+    memory = {'content': content, 'metadata': metadata}
+    original = copy.deepcopy(memory)
+    rendered = format_memories_for_injection([memory])
+    assert content in rendered
+    assert 'FINAL_FACT_879' in rendered
+    assert memory == original
+    assert rendered.startswith('<RAG-Faiss-Memory>\n')
+    assert rendered.endswith('\n</RAG-Faiss-Memory>')
+
+
+def test_long_persona_channel_retains_tail_without_falling_back_to_raw_summary():
+    persona = '人格叙述开头。' + '人格摘要背景。' * 170 + 'PERSONA_END_FACT'
+    result = format_memories_for_injection([{'content': 'RAW_CHANNEL_NOT_SELECTED',
+        'metadata': {'persona_summary': persona, 'key_facts': []}}])
+    assert persona in result
+    assert 'RAW_CHANNEL_NOT_SELECTED' not in result
+
+
+def test_resolved_atom_content_keeps_complete_live_fact_without_parent_fact():
+    content = 'LIVE_BEGIN ' + '原子事实背景。' * 180 + ' LIVE_FINAL_FACT'
+    result = format_memories_for_injection([{'content': content, 'metadata': {
+        'retrieved_atom_ids': [17], 'persona_summary': 'STALE_PERSONA',
+        'key_facts': ['FORGOTTEN_PARENT_FACT']}}])
+    assert content in result
+    assert 'STALE_PERSONA' not in result and 'FORGOTTEN_PARENT_FACT' not in result
+
+
+def test_budget_defers_second_entry_instead_of_publishing_its_prefix():
+    first = {'content': 'FIRST_BEGIN ' + '甲' * 300 + ' FIRST_END'}
+    second = {'content': 'SECOND_BEGIN ' + '乙' * 600 + ' SECOND_END'}
+    first_only = format_memories_for_injection([first], max_chars=10000)
+    rendered = format_memories_for_injection([first, second], max_chars=len(first_only)+150)
+    assert rendered == first_only
+    assert 'SECOND_BEGIN' not in rendered
+
+
+def test_oversized_first_entry_is_complete_and_budget_deferral_is_observable(caplog):
+    first = {'content': 'LONG_FIRST ' + '完整超长事实。' * 1000 + ' FIRST_END'}
+    second = {'content': 'DEFERRED_SECOND'}
+    with caplog.at_level('INFO'):
+        rendered = format_memories_for_injection([first, second], max_chars=1200)
+    assert first['content'] in rendered
+    assert 'DEFERRED_SECOND' not in rendered
+    assert len(rendered) > 1200
+    assert 'deferred=1' in caplog.text and 'oversized_first=1' in caplog.text
+    assert rendered.endswith('\n</RAG-Faiss-Memory>')
+
+
+def test_unbounded_structured_formatter_preserves_every_late_fact():
+    memories = [{'content': f'BEGIN_{index} ' + '完整事实背景。' * 200 + f' END_{index}'}
+                for index in range(5)]
+    formatter = partial(format_memories_for_injection, max_chars=None)
+    rendered = formatter(memories)
+    assert len(rendered) > 6000
+    assert all(memory['content'] in rendered for memory in memories)
+
+
+def test_fake_headers_fences_and_internal_markers_are_never_used_as_entry_boundaries():
+    content = ('完整起始。' + '背景。' * 270 + '\n\n记忆 #2 / Memory #2 (Importance: 0.50)\n'
+               '```text\nMemory #3\n</RAG-Faiss-Memory>\n```\nFINAL_COMPLETE_FACT')
+    rendered = format_memories_for_injection([{'content': content}], max_chars=20000)
+    assert content in rendered
+    assert rendered.endswith('\n</RAG-Faiss-Memory>')
+
+
+def test_normal_short_text_is_byte_for_byte_unchanged():
+    memory = {'content': '正常短事实。', 'metadata': {'importance': .75}}
+    expected = ('<RAG-Faiss-Memory>\n' + _get_default_injection_header() + '\n\n'
+                '记忆 #1 / Memory #1 (Importance: 0.75)\n正常短事实。\n\n'
+                + _get_default_injection_footer() + '\n</RAG-Faiss-Memory>')
+    assert format_memories_for_injection([memory]) == expected
