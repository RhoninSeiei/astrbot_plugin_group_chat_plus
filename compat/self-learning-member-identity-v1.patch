diff --git a/services/identity/service.py b/services/identity/service.py
new file mode 100644
index 0000000..4fb5f12
--- /dev/null
+++ b/services/identity/service.py
@@ -0,0 +1,349 @@
+"""Bounded, local identity facts. Nicknames are preferences, never authority."""
+import asyncio
+from contextlib import closing
+import hashlib
+import json
+import os
+import re
+import sqlite3
+import time
+import unicodedata
+from pathlib import Path
+
+_QQ = re.compile(r'[1-9][0-9]{3,19}\Z')
+_RESERVED = {'管理员', '群主', '系统', '机器人', 'admin', 'system', 'assistant', 'developer', '所有人', '大家', '我', '你', '他'}
+_SELF = re.compile(r'(请叫我|我的花名是|我的昵称是|别叫我|我的花名不是)(.+?)[。！!]?\Z')
+_THIRD = re.compile(r'@([1-9][0-9]{3,19})(?:也叫|的花名是|的昵称是)(.+?)[。！!]?\Z')
+
+
+def clean_name(value, limit=48):
+    if not isinstance(value, str):
+        return ''
+    value = unicodedata.normalize('NFKC', value).strip()
+    if not value or len(value) > limit or any(unicodedata.category(c).startswith('C') for c in value):
+        return ''
+    return value
+
+
+def alias_value(value):
+    value = clean_name(value, 28)
+    pairs = [('“', '”'), ('「', '」'), ('"', '"'), ("'", "'")]
+    for left, right in pairs:
+        if value.startswith(left) and value.endswith(right):
+            value = value[1:-1].strip()
+            break
+    if not 2 <= len(value) <= 24 or any(c in value for c in '\n\r<>[]{}@,，。！？!?:：;；“”「」"\''):
+        return ''
+    if value.casefold() in _RESERVED or value.isdecimal():
+        return ''
+    return value
+
+
+class IdentityService:
+    """Single writer; all consumers receive detached JSON-compatible snapshots."""
+    def __init__(self, data_dir, config, *, qq_filter=None, database=None):
+        self.path = Path(data_dir) / 'identity' / 'identity.sqlite3'
+        self.config, self.qq_filter, self.database = config, qq_filter, database
+        self._closed = False
+        self._ready = False
+        self._lock = asyncio.Lock()
+        self._pending = 0
+
+    def _mode(self):
+        value = getattr(self.config, 'identity_mode', 'off')
+        return value if value in ('off', 'shadow', 'active') else 'off'
+
+    async def start(self):
+        if self._closed or self._mode() == 'off' or not getattr(self.config, 'identity_allowed_sessions', []):
+            return
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            await self._run(self._initialize)
+            if os.name != "nt":
+                os.chmod(self.path.parent, 0o700)
+                os.chmod(self.path, 0o600)
+            self._ready = True
+        except (OSError, sqlite3.Error):
+            self._ready = False
+
+    def _initialize(self, con):
+        con.executescript('''
+          CREATE TABLE IF NOT EXISTS members (
+            adapter TEXT, scope TEXT, user_id TEXT, display_name TEXT,
+            names TEXT NOT NULL, updated INTEGER NOT NULL,
+            PRIMARY KEY(adapter,scope,user_id));
+          CREATE TABLE IF NOT EXISTS observed_names (
+            adapter TEXT, scope TEXT, user_id TEXT, normalized TEXT, name TEXT,
+            PRIMARY KEY(adapter,scope,user_id,normalized));
+          CREATE TABLE IF NOT EXISTS aliases (
+            adapter TEXT, scope TEXT, user_id TEXT, normalized TEXT, alias TEXT,
+            state TEXT, updated INTEGER NOT NULL,
+            PRIMARY KEY(adapter,scope,user_id,normalized));
+          CREATE TABLE IF NOT EXISTS events (
+            key TEXT PRIMARY KEY, adapter TEXT, scope TEXT, updated INTEGER NOT NULL);
+          CREATE TABLE IF NOT EXISTS claims (
+            event_key TEXT, adapter TEXT, scope TEXT, subject TEXT, actor TEXT,
+            alias TEXT, kind TEXT, updated INTEGER NOT NULL,
+            PRIMARY KEY(event_key,subject,alias));
+        ''')
+
+    async def _run(self, operation):
+        if self._closed or self._pending >= 16:
+            raise RuntimeError('identity_unavailable')
+        self._pending += 1
+        try:
+            async with self._lock:
+                if self._closed:
+                    raise RuntimeError('identity_closed')
+                def run():
+                    with closing(sqlite3.connect(self.path, timeout=0.1)) as con:
+                        con.row_factory = sqlite3.Row
+                        with con:
+                            return operation(con)
+                task = asyncio.create_task(asyncio.to_thread(run))
+                try:
+                    return await asyncio.shield(task)
+                except asyncio.CancelledError:
+                    # A cancelled coroutine must not release the writer lock while
+                    # SQLite is still committing in its worker thread.
+                    await task
+                    raise
+        finally:
+            self._pending -= 1
+
+    async def close(self):
+        self._closed = True
+        self._ready = False
+        async with self._lock:
+            pass
+
+    def _snapshot(self, event):
+        try:
+            adapter = str(event.get_platform_id() or '')
+            scope = str(event.unified_msg_origin or '')
+            group = str(event.get_group_id() or '')
+            sender = str(event.get_sender_id() or '')
+            if not adapter or len(adapter) > 96 or len(scope) > 256 or not _QQ.fullmatch(sender) or not _QQ.fullmatch(group):
+                return None
+            if scope != f'{adapter}:GroupMessage:{group}':
+                return None
+            if scope not in getattr(self.config, 'identity_allowed_sessions', []):
+                return None
+            components = event.get_messages() or []
+            if not isinstance(components, (list, tuple)):
+                return None
+            self_id = getattr(event, 'get_self_id', lambda: '')()
+            if str(self_id or '') == sender:
+                return None
+            parts, mentioned, quoted = [], [], []
+            unsafe = False
+            for part in components[:64]:
+                kind = type(part).__name__
+                if kind == 'Plain':
+                    plain = str(getattr(part, 'text', ''))
+                    if len(plain) > 2000:
+                        unsafe = True
+                    parts.append(plain[:2000])
+                elif kind == 'At':
+                    target = str(getattr(part, 'qq', '') or '')
+                    if _QQ.fullmatch(target):
+                        mentioned.append(target)
+                        parts.append('@' + target)
+                elif kind == 'Reply':
+                    target = str(getattr(part, 'sender_id', '') or '')
+                    if _QQ.fullmatch(target):
+                        quoted.append(target)
+                    unsafe = True
+                else:
+                    unsafe = True
+            if len(components) > 64:
+                unsafe = True
+            text = ''.join(parts).strip()
+            if len(text) > 2000:
+                text, unsafe = text[:2000], True
+            message_id = str(getattr(getattr(event, 'message_obj', None), 'message_id', '') or '')
+            key = hashlib.sha256(json.dumps([adapter,scope,sender,message_id],ensure_ascii=False).encode()).hexdigest() if message_id else None
+            # Preserve reception order when the API races the message collector.
+            order = time.time_ns()
+            extra = getattr(event, 'get_extra', None)
+            prior = extra('_sl_identity_reception_v1') if callable(extra) else None
+            if isinstance(prior, dict) and prior.get('key') == key and prior.get('scope') == scope and isinstance(prior.get('order'), int):
+                order = prior['order']
+            setter = getattr(event, 'set_extra', None)
+            if callable(setter):
+                setter('_sl_identity_reception_v1', {'key':key,'scope':scope,'order':order})
+            return {'adapter':adapter,'scope':scope,'group':group,'sender':sender,
+                    'display':clean_name(event.get_sender_name()),'text':text,
+                    'mentions':mentioned[:8],'quotes':quoted[:8],'unsafe':unsafe,
+                    'key':key,'order':order}
+        except Exception:
+            return None
+
+    def prepare_event(self, event):
+        """Capture arrival order before scheduling the existing background pipeline."""
+        if not self._closed and self._mode() != "off":
+            self._snapshot(event)
+
+    def _filter_allowed(self, snap):
+        if self.qq_filter is not None:
+            try:
+                return bool(self.qq_filter.should_collect_message(snap['sender'], snap['group']))
+            except Exception:
+                return False
+        return True
+
+    def _collect_allowed(self, snap):
+        return bool(getattr(self.config, "enable_message_capture", True)) and self._filter_allowed(snap)
+
+    async def observe_event(self, event):
+        snap = self._snapshot(event)
+        if self._closed or not self._ready or self._mode() == 'off' or not snap or not snap['key'] or not self._collect_allowed(snap):
+            return False
+        mode = self._mode()
+        try:
+            return await self._run(lambda con:self._observe(con,snap,mode))
+        except (OSError, sqlite3.Error, RuntimeError):
+            return False
+
+    def _observe(self, con, s, mode):
+        con.execute('BEGIN IMMEDIATE')
+        if con.execute('SELECT 1 FROM events WHERE key=?',(s['key'],)).fetchone():
+            return True
+        con.execute('INSERT INTO events VALUES (?,?,?,?)',(s['key'],s['adapter'],s['scope'],s['order']))
+        row = con.execute('SELECT * FROM members WHERE adapter=? AND scope=? AND user_id=?',(s['adapter'],s['scope'],s['sender'])).fetchone()
+        if row is None or s['order'] >= row['updated']:
+            names = json.loads(row['names']) if row else []
+            if s['display']:
+                candidates, names, seen = [s['display']] + names, [], set()
+                for name in candidates:
+                    normalized = name.casefold()
+                    if normalized not in seen:
+                        names.append(name)
+                        seen.add(normalized)
+                names = names[:8]
+            con.execute('INSERT OR REPLACE INTO members VALUES (?,?,?,?,?,?)',(s['adapter'],s['scope'],s['sender'],s['display'],json.dumps(names,ensure_ascii=False),s['order']))
+            con.execute('DELETE FROM observed_names WHERE adapter=? AND scope=? AND user_id=?',(s['adapter'],s['scope'],s['sender']))
+            con.executemany('INSERT INTO observed_names VALUES (?,?,?,?,?)',[(s['adapter'],s['scope'],s['sender'],name.casefold(),name) for name in names])
+        if not s['unsafe']:
+            match = _SELF.fullmatch(s['text'])
+            subject, actor, value, kind = s['sender'],s['sender'],'',''
+            if match:
+                value = alias_value(match[2])
+                kind = 'self_denied' if match[1] in ('别叫我','我的花名不是') else 'self_confirmed'
+            else:
+                match = _THIRD.fullmatch(s['text'])
+                if match and match[1] in s['mentions'] and match[1] != s['sender']:
+                    subject,value,kind = match[1],alias_value(match[2]),'candidate'
+            if value:
+                con.execute('INSERT OR IGNORE INTO claims VALUES (?,?,?,?,?,?,?,?)',(s['key'],s['adapter'],s['scope'],subject,actor,value,kind,s['order']))
+                if mode == 'active' and kind.startswith('self_'):
+                    old = con.execute('SELECT updated FROM aliases WHERE adapter=? AND scope=? AND user_id=? AND normalized=?',(s['adapter'],s['scope'],subject,value.casefold())).fetchone()
+                    if old is None or s['order'] > old['updated']:
+                        con.execute('INSERT OR REPLACE INTO aliases VALUES (?,?,?,?,?,?,?)',(s['adapter'],s['scope'],subject,value.casefold(),value,kind,s['order']))
+        # Bound replay ledger/candidates; never prune confirmed decisions or denials.
+        for table in ('claims',):
+            con.execute(f'DELETE FROM {table} WHERE rowid IN (SELECT rowid FROM {table} WHERE adapter=? AND scope=? ORDER BY updated DESC LIMIT -1 OFFSET 2048)',(s['adapter'],s['scope']))
+        return True
+
+    @staticmethod
+    def _empty(status, scope=''):
+        return {'version':1,'status':status,'scope':scope,'subjects':[], 'unresolved':[], 'relations':[]}
+
+    async def get_identity_context(self, event, *, subject_ids=(), aliases=(), include_relations=True):
+        snap = self._snapshot(event)
+        if self._mode() == 'off' or not snap:
+            return self._empty('off')
+        if self._closed or not self._ready:
+            return self._empty('unavailable',snap['scope'])
+        try:
+            if not self._filter_allowed(snap):
+                return self._empty('off')
+            if self._collect_allowed(snap):
+                if not await asyncio.wait_for(self.observe_event(event), timeout=0.35):
+                    return self._empty('unavailable',snap['scope'])
+            if self._mode() == 'shadow':
+                return self._empty('shadow',snap['scope'])
+            result = await asyncio.wait_for(self._run(lambda con:self._read(con,snap,subject_ids,aliases)),timeout=0.35)
+            if include_relations and self.database and snap["scope"] in getattr(self.config, "identity_relation_scopes", []):
+                try:
+                    await asyncio.wait_for(self._relations(result,snap),timeout=0.2)
+                except asyncio.TimeoutError:
+                    pass
+            return result
+        except (Exception, asyncio.CancelledError) as exc:
+            if isinstance(exc, asyncio.CancelledError):
+                raise
+            return self._empty('unavailable',snap['scope'])
+
+    def _read(self, con, s, requested_ids, requested_aliases):
+        result = self._empty('ready',s['scope'])
+        roles = {s['sender']:['sender']}
+        for label,ids in [('mention',s['mentions']),('quote',s['quotes'])]:
+            for uid in ids:
+                roles.setdefault(uid,[])
+                if label not in roles[uid]: roles[uid].append(label)
+        allowed = set(roles)
+        selected = [s['sender']]
+        hints = list(requested_ids[:8]) if isinstance(requested_ids, (list,tuple)) else []
+        for uid in hints + s['mentions'] + s['quotes']:
+            uid = str(uid)
+            if uid in allowed and uid not in selected and len(selected)<8: selected.append(uid)
+        rows = con.execute('SELECT user_id,alias,normalized FROM aliases WHERE adapter=? AND scope=? AND state=? AND instr(?,normalized)>0 ORDER BY updated DESC',(s['adapter'],s['scope'],'self_confirmed',unicodedata.normalize('NFKC',s['text']).casefold())).fetchall()
+        rows = list(rows) + list(con.execute('SELECT user_id,name AS alias,normalized FROM observed_names WHERE adapter=? AND scope=? AND instr(?,normalized)>0',(s['adapter'],s['scope'],unicodedata.normalize('NFKC',s['text']).casefold())).fetchall())
+        text = unicodedata.normalize('NFKC',s['text']).casefold()
+        matched = {}
+        for row in rows:
+            norm=row['normalized']
+            if norm not in text: continue
+            if norm.isascii() and re.search(r'(?<!\w)'+re.escape(norm)+r'(?!\w)',text) is None: continue
+            matched.setdefault(norm,{'alias':row['alias'],'ids':set()})['ids'].add(row['user_id'])
+        denied = con.execute('SELECT user_id,normalized,alias FROM aliases WHERE adapter=? AND scope=? AND state=?',(s['adapter'],s['scope'],'self_denied')).fetchall()
+        denied_by_user = {}
+        for row in denied:
+            denied_by_user.setdefault(row['user_id'],set()).add(row['normalized'])
+            if row['normalized'] in matched:
+                matched[row['normalized']]['ids'].discard(row['user_id'])
+            if row['normalized'] in text and (row['normalized'] not in matched or not matched[row['normalized']]['ids']):
+                result['unresolved'].append({'alias':row['alias'],'status':'denied'})
+        # Caller hints cannot introduce names absent from this request.
+        for found in list(matched.values())[:8]:
+            if not found['ids']:
+                continue
+            if len(found['ids']) != 1:
+                result['unresolved'].append({'alias':found['alias'],'status':'ambiguous'})
+                continue
+            uid=next(iter(found['ids']))
+            if uid not in selected and len(selected)>=8: continue
+            if uid not in selected: selected.append(uid)
+            roles.setdefault(uid,[])
+            if 'alias' not in roles[uid]: roles[uid].append('alias')
+        for uid in selected:
+            member=con.execute('SELECT * FROM members WHERE adapter=? AND scope=? AND user_id=?',(s['adapter'],s['scope'],uid)).fetchone()
+            facts=con.execute('SELECT alias FROM aliases WHERE adapter=? AND scope=? AND user_id=? AND state=? ORDER BY updated DESC LIMIT 8',(s['adapter'],s['scope'],uid,'self_confirmed')).fetchall()
+            denied_names = denied_by_user.get(uid,set())
+            names = [name for name in json.loads(member['names']) if name.casefold() not in denied_names] if member else []
+            display = member['display_name'] if member and member['display_name'].casefold() not in denied_names else ''
+            result['subjects'].append({'user_id':uid,'display_name':display, 'observed_names':names, 'confirmed_aliases':[r['alias'] for r in facts],'roles':roles.get(uid,[])})
+        result['unresolved'] = result['unresolved'][:8]
+        return result
+
