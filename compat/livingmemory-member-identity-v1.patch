+    def _recent_query_context(self, recent_messages, max_age_seconds, now,
+                              current_message_id=None):
+        """Preserve store order; never infer the current group row from its text."""
+        parts = []
+        skipped_by_age = 0
+        for message in recent_messages:
+            if not isinstance(message, dict):
+                continue
+            if current_message_id is not None and message.get('id') == current_message_id:
+                continue
+            if max_age_seconds > 0:
+                timestamp = self._message_timestamp_seconds(message.get('timestamp'))
+                if timestamp is None or now - timestamp > max_age_seconds:
+                    skipped_by_age += 1
+                    continue
+            content = message.get('content', '')
+            if isinstance(content, str) and content.strip():
+                parts.append(content.strip())
+        return parts, skipped_by_age
+
+    @staticmethod
+    def _augment_identity_query(event, req, query, recall_session_id, *, current_query=None):
+        """Use confirmed in-group identity anchors in the original single search.
+
+        A participant identifies a conversation window, not the subject or owner
+        of every fact inside it. This path never filters candidates by people.
+        """
+        try:
+            if req is None or not isinstance(query, str) or not query.strip():
+                return query
+            payload = event.get_extra('_gcp_member_identity_v1', None)
+            if not isinstance(payload, dict) or payload.get('request') is not req:
+                return query
+            snapshot = payload.get('snapshot')
+            if not isinstance(snapshot, dict):
+                return query
+            scope = getattr(event, 'unified_msg_origin', None)
+            if (type(snapshot.get('version')) is not int or snapshot['version'] != 1
+                    or snapshot.get('status') != 'ready' or not isinstance(scope, str)
+                    or not scope or snapshot.get('scope') != scope or recall_session_id != scope):
+                return query
+            subjects = snapshot.get('subjects')
+            if not isinstance(subjects, list) or len(subjects) > 8:
+                return query
+            speaker = str(event.get_sender_id() or '')
+            bot = str(event.get_self_id() or '')
+            current = current_query if isinstance(current_query, str) else query
+            anchors = []
+            seen = set()
+            prefix = '\n身份检索锚点（仅定位，不证明事实归属）: '
+            anchor_budget = min(512, 2000 - len(query))
+            for subject in subjects:
+                if not isinstance(subject, dict):
+                    continue
+                uid = subject.get('user_id')
+                roles = subject.get('roles')
+                if (not isinstance(uid, str) or not uid.strip() or len(uid) > 128
+                        or uid in {speaker, bot} or uid in seen or not isinstance(roles, list)):
+                    continue
+                explicit = any(role in {'mention', 'quote'} for role in roles if isinstance(role, str))
+                aliases = subject.get('confirmed_aliases')
+                aliases = aliases if isinstance(aliases, list) else []
+                aliases = list(dict.fromkeys(alias.strip() for alias in aliases
+                    if isinstance(alias, str) and 0 < len(alias.strip()) <= 64))[:3]
+                if not explicit:
+                    if 'alias' not in roles:
+                        continue
+                    aliases = [alias for alias in aliases if alias in current]
+                    if not aliases:
+                        continue
+                anchor = {'user_id': uid}
+                name = subject.get('display_name')
+                if isinstance(name, str) and 0 < len(name.strip()) <= 64 and name.strip() != uid:
+                    anchor['display_name'] = name.strip()
+                if aliases:
+                    anchor['confirmed_aliases'] = aliases
+                encoded = json.dumps(anchors + [anchor], ensure_ascii=False, separators=(',', ':'))
+                if len(prefix) + len(encoded) > anchor_budget:
+                    continue
+                anchors.append(anchor)
+                seen.add(uid)
+            if anchors:
+                return query + prefix + json.dumps(anchors, ensure_ascii=False, separators=(',', ':'))
+        except Exception:
+            # Identity availability must never turn successful recall into failure.
+            return query
+        return query
