-# Group ids are numeric platform ids (optionally with provider prefixes);
-# anything else must never reach filesystem paths.
-SAFE_GROUP_ID_PATTERN = re.compile(r"^[A-Za-z0-9_\-:]{1,64}$")
+# Literal platform scopes may include account/provider dots and @ signs.
+# Keep existing names unchanged; path containment is checked independently.
+SAFE_GROUP_ID_PATTERN = re.compile(r"^[A-Za-z0-9_\-:.@]{1,64}$")
+
+
+def _resolve_group_working_dir(base_dir: str, group_id: str) -> str:
+    """Validate a literal single-component workspace without renaming data."""
+    if (not isinstance(group_id, str)
+            or not SAFE_GROUP_ID_PATTERN.fullmatch(group_id)
+            or group_id in {".", ".."}
+            or ntpath.splitdrive(group_id)[0]):
+        raise ValueError("Invalid LightRAG group scope")
+    path = os.path.join(base_dir, group_id)
+    base_real = os.path.realpath(base_dir)
+    path_real = os.path.realpath(path)
+    try:
+        contained = os.path.commonpath([base_real, path_real]) == base_real
+    except ValueError:
+        contained = False
+    if not contained or path_real == base_real or os.path.islink(path):
+        raise ValueError("Invalid LightRAG group scope")
+    return path
 
 
