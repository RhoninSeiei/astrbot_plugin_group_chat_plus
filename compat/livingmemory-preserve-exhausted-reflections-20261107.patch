diff --git a/tests/test_reflection_exhaustion.py b/tests/test_reflection_exhaustion.py
new file mode 100644
index 0000000..bee82dc
--- /dev/null
+++ b/tests/test_reflection_exhaustion.py
@@ -0,0 +1,203 @@
+"""Failed reflection segments must remain recoverable without automatic retries."""
+
+import asyncio
+from unittest.mock import AsyncMock, Mock, patch
+
+import pytest
+
+from astrbot_plugin_livingmemory.core.command_handler import CommandHandler
+from tests.event_handler_support import _make_real_handler
+
+
+SESSION = "test:GroupMessage:reflection-recovery"
+PENDING = {"start_index": 0, "end_index": 4, "retry_count": 3}
+
+
+async def _setup(tmp_path):
+    handler, manager, store = await _make_real_handler(tmp_path)
+    for index in range(4):
+        await manager.add_message(
+            session_id=SESSION,
+            role="user" if index % 2 == 0 else "assistant",
+            content=f"synthetic-{index}",
+            sender_id="tester" if index % 2 == 0 else "bot",
+            group_id="reflection-recovery",
+        )
+    handler.memory_processor.process_conversation = AsyncMock(
+        return_value=("synthetic summary", {"topics": ["synthetic"]}, 0.6)
+    )
+    handler.memory_processor.classify_atoms_from_metadata = Mock(return_value=[])
+    handler.memory_engine.find_similar_memory = AsyncMock(return_value=None)
+    handler.memory_engine.add_memory = AsyncMock(return_value=1)
+    return handler, manager, store
+
+
+async def _plan(handler, manager):
+    return await handler._memory_reflection._build_reflection_plan_for_cursor(
+        SESSION,
+        await manager.store.get_message_count(SESSION),
+        await manager.get_session_metadata(SESSION, "last_summarized_index", 0),
+        await manager.get_session_metadata(SESSION, "pending_summary", None),
+        await manager.get_session_revision(SESSION),
+        "persona-synthetic",
+        SESSION,
+    )
+
+
+async def _run(handler, plan):
+    await handler._memory_reflection._schedule_reflection(plan)
+    await asyncio.gather(*list(handler._storage_tasks))
+
+
+@pytest.mark.asyncio
+async def test_exhausted_segment_survives_new_messages_and_cold_reopen(tmp_path):
+    handler, manager, store = await _setup(tmp_path)
+    try:
+        await manager.update_session_metadata(SESSION, "pending_summary", dict(PENDING))
+        for _ in range(2):
+            assert await _plan(handler, manager) is None
+        await manager.add_message(SESSION, "user", "new synthetic request", "tester")
+        assert await _plan(handler, manager) is None
+        assert await manager.get_session_metadata(SESSION, "pending_summary") == PENDING
+        assert await manager.get_session_metadata(SESSION, "last_summarized_index", 0) == 0
+        handler.memory_processor.process_conversation.assert_not_awaited()
+        handler.memory_engine.add_memory.assert_not_awaited()
+    finally:
+        await handler.shutdown()
+        await store.close()
+
+    # A new manager/handler reads the pause from SQLite, with no in-memory flag.
+    from astrbot_plugin_livingmemory.storage.conversation_store import ConversationStore
+    from astrbot_plugin_livingmemory.core.managers.conversation_manager import ConversationManager
+
+    reopened = ConversationStore(str(tmp_path / "conv-history.db"))
+    await reopened.initialize()
+    manager2 = ConversationManager(store=reopened)
+    handler.conversation_manager = manager2
+    handler._memory_reflection.conversation_manager = manager2
+    try:
+        assert await _plan(handler, manager2) is None
+        assert await manager2.get_session_metadata(SESSION, "pending_summary") == PENDING
+        assert await manager2.get_session_metadata(SESSION, "last_summarized_index", 0) == 0
+    finally:
+        await reopened.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("prior_failures", [0, 2])
+async def test_storage_failure_retains_segment_and_stops_at_limit(tmp_path, prior_failures):
+    handler, manager, store = await _setup(tmp_path)
+    try:
+        if prior_failures:
+            await manager.update_session_metadata(
+                SESSION, "pending_summary", {**PENDING, "retry_count": prior_failures}
+            )
+        handler.memory_engine.add_memory.side_effect = TimeoutError("synthetic embedding timeout")
+        await _run(handler, await _plan(handler, manager))
+        assert await manager.get_session_metadata(SESSION, "pending_summary") == {
+            **PENDING, "retry_count": prior_failures + 1
+        }
+        assert await manager.get_session_metadata(SESSION, "last_summarized_index", 0) == 0
+        if prior_failures == 2:
+            assert await _plan(handler, manager) is None
+            assert await manager.get_session_metadata(SESSION, "pending_summary") == PENDING
+            assert await manager.get_session_metadata(SESSION, "last_summarized_index", 0) == 0
+            assert handler.memory_processor.process_conversation.await_count == 1
+            assert handler.memory_engine.add_memory.await_count == 1
+    finally:
+        await handler.shutdown()
+        await store.close()
+
+
+@pytest.mark.asyncio
+async def test_success_advances_cursor_and_clears_prior_failure(tmp_path):
+    handler, manager, store = await _setup(tmp_path)
+    try:
+        await manager.update_session_metadata(SESSION, "pending_summary", {**PENDING, "retry_count": 1})
+        await _run(handler, await _plan(handler, manager))
+        assert await manager.get_session_metadata(SESSION, "last_summarized_index", 0) == 4
+        assert await manager.get_session_metadata(SESSION, "pending_summary") is None
+    finally:
+        await handler.shutdown()
+        await store.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("failed", [False, True])
+async def test_explicit_summarize_recovers_only_after_success(tmp_path, failed):
+    handler, manager, store = await _setup(tmp_path)
+    try:
+        await manager.update_session_metadata(SESSION, "pending_summary", dict(PENDING))
+        # Manual recovery must pass the complete backlog, even beyond the normal
+        # automatic 120-message segment size, before advancing its cursor.
+        for index in range(124):
+            await manager.add_message(SESSION, "user", f"backlog-{index}", "tester")
+        if failed:
+            handler.memory_engine.add_memory.side_effect = TimeoutError("synthetic embedding timeout")
+        command = CommandHandler(
+            handler.context, handler.config_manager, handler.memory_engine,
+            manager, None, memory_processor=handler.memory_processor,
+        )
+        event = Mock(unified_msg_origin=SESSION)
+        event.plain_result.side_effect = lambda text: text
+        with patch("astrbot_plugin_livingmemory.core.command_handler.is_event_memory_allowed", return_value=True), patch(
+            "astrbot_plugin_livingmemory.core.utils.get_persona_id", AsyncMock(return_value="persona-synthetic")
+        ):
+            results = [value async for value in command.handle_summarize(event)]
+        assert results
+        source = handler.memory_processor.process_conversation.await_args.kwargs["messages"]
+        assert len(source) == 128
+        assert source[0].content == "synthetic-0"
+        assert source[-1].content == "backlog-123"
+        handler.memory_engine.add_memory.assert_awaited_once()
+        assert handler.memory_engine.add_memory.await_args.kwargs["metadata"]["source_window"] == {
+            "session_id": SESSION, "start_index": 0, "end_index": 128,
+            "message_count": 128, "triggered_by": "manual",
+        }
+        assert await manager.get_session_metadata(SESSION, "last_summarized_index", 0) == (0 if failed else 128)
+        assert await manager.get_session_metadata(SESSION, "pending_summary") == (PENDING if failed else None)
+    finally:
+        await handler.shutdown()
+        await store.close()
+
+
+@pytest.mark.asyncio
+async def test_stale_failure_cannot_restore_exhausted_segment_after_reset(tmp_path):
+    handler, manager, store = await _setup(tmp_path)
+    try:
+        old_revision = await manager.get_session_revision(SESSION)
+        await manager.bump_session_revision(SESSION)
+        await handler._memory_reflection._record_pending_summary(
+            SESSION, 0, 4, 2, old_revision
+        )
+        assert await manager.get_session_metadata(SESSION, "pending_summary") is None
+        assert await manager.get_session_metadata(SESSION, "last_summarized_index", 0) == 0
+    finally:
+        await handler.shutdown()
+        await store.close()
+
+
+@pytest.mark.asyncio
+async def test_cancellation_preserves_previous_pending_segment(tmp_path):
+    handler, manager, store = await _setup(tmp_path)
+    started = asyncio.Event()
+
+    async def waiting_summary(**kwargs):
+        started.set()
+        await asyncio.Event().wait()
+
+    try:
+        previous = {**PENDING, "retry_count": 1}
+        await manager.update_session_metadata(SESSION, "pending_summary", previous)
+        handler.memory_processor.process_conversation.side_effect = waiting_summary
+        await handler._memory_reflection._schedule_reflection(await _plan(handler, manager))
+        await asyncio.wait_for(started.wait(), timeout=2)
+        # The real lifecycle shutdown cancels and awaits the in-flight task.
+        await handler.shutdown()
+        assert not handler._storage_tasks
+        assert await manager.get_session_metadata(SESSION, "pending_summary") == previous
+        assert await manager.get_session_metadata(SESSION, "last_summarized_index", 0) == 0
+        handler.memory_engine.add_memory.assert_not_awaited()
+    finally:
+        await handler.shutdown()
+        await store.close()
